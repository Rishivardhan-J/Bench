# Client (Vite). Everything is optional.
# Set to "false" to browse bundled demo profiles with no backend.
VITE_USE_LIVE_DATA="true"
# Where the Vite dev server proxies /api (including the WebSocket).
VITE_API_TARGET="http://127.0.0.1:8787"
VITE_SENTRY_DSN=""

# The API server has its own settings: see server/.env.example.
