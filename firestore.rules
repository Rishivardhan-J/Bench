rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function hasRole(r) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == r;
    }
    function threadOf(tid) { return get(/databases/$(database)/documents/threads/$(tid)); }
    function changed(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }

    // Roles and server-owned records are written only by Cloud Functions.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;

      match /settings/{doc} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && request.resource.data.keys().size() <= 8;
      }
      match /blocked/{other} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /clientProfiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'company', 'avatarUrl'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.company is string && request.resource.data.company.size() <= 80;
      allow create, delete: if false;
    }

    // Freelancer profiles. Public only when approved and not paused. Moderation fields
    // and rating/response stats are server-owned; editing core fields returns a live profile to review.
    match /freelancerProfiles/{uid} {
      allow get, list: if (resource.data.approved == true && resource.data.paused == false)
        || isOwner(uid) || isAdmin();

      allow create, delete: if false;

      allow update: if isOwner(uid)
        && !changed(['verified', 'ratingAvg', 'reviewCount', 'avgResponseMinutes', 'completeness',
                     'replyCount', 'replyMinutesTotal', 'reviewNote', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.headline is string && request.resource.data.headline.size() <= 120
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 1000
        && request.resource.data.skills is list && request.resource.data.skills.size() <= 30
        && request.resource.data.rateMin is number && request.resource.data.rateMin >= 0
        && request.resource.data.rateMax is number && request.resource.data.rateMax >= request.resource.data.rateMin
        && request.resource.data.paused is bool
        && request.resource.data.availability in ['now', 'this_week', 'busy', 'offline']
        && request.resource.data.experience.size() <= 10
        && request.resource.data.education.size() <= 6
        && request.resource.data.portfolio.size() <= 6
        && (
          // Not live after this write: free to edit, may submit for review.
          (request.resource.data.approved == false && request.resource.data.reviewStatus in ['draft', 'pending'])
          // Stays live: only non-core fields (availability, paused) may change.
          || (resource.data.approved == true && request.resource.data.approved == true
              && request.resource.data.reviewStatus == 'approved'
              && !changed(['name', 'headline', 'bio', 'skills', 'rateMin', 'rateMax', 'currency', 'timezone',
                           'portfolioUrl', 'avatarUrl', 'languages', 'experience', 'education', 'portfolio']))
        );
    }

    // Reviews are public by design; only functions write them.
    match /reviews/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /shortlists/{uid}/lists/{listId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && hasRole('client')
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.items is list && request.resource.data.items.size() <= 200;
    }

    match /connections/{id} {
      allow read: if signedIn() && (resource.data.clientUid == request.auth.uid || resource.data.freelancerUid == request.auth.uid);
      allow write: if false;
    }

    match /threads/{tid} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      // A participant may only clear their own unread count and stamp their own read time.
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread', 'lastRead'])
        && request.resource.data.unread.diff(resource.data.unread).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.unread[request.auth.uid] == 0
        && request.resource.data.lastRead.diff(resource.data.lastRead).affectedKeys().hasOnly([request.auth.uid]);
      allow create, delete: if false;

      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in threadOf(tid).data.participants;
        allow create: if signedIn()
          && request.auth.uid in threadOf(tid).data.participants
          && threadOf(tid).data.get('closed', false) != true
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'attachments', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000
          && request.resource.data.attachments is list && request.resource.data.attachments.size() <= 5
          && (request.resource.data.text.size() > 0 || request.resource.data.attachments.size() > 0)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /hires/{id} {
      allow read: if signedIn() && (resource.data.clientUid == request.auth.uid || resource.data.freelancerUid == request.auth.uid);
      allow write: if false;
    }

    match /notifications/{uid}/items/{id} {
      allow read, delete: if isOwner(uid);
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if false;
    }

    match /projects/{id} {
      allow read: if signedIn() && (resource.data.status == 'open' || resource.data.clientUid == request.auth.uid || isAdmin());
      allow create: if hasRole('client')
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() <= 4000
        && request.resource.data.skills is list && request.resource.data.skills.size() <= 15;
      allow update: if isOwner(resource.data.clientUid)
        && request.resource.data.clientUid == resource.data.clientUid
        && request.resource.data.status in ['open', 'closed']
        && request.resource.data.title.size() <= 120
        && request.resource.data.description.size() <= 4000;
      allow delete: if isOwner(resource.data.clientUid);
    }

    // One proposal per freelancer per project: the document id enforces it.
    match /proposals/{id} {
      allow read: if signedIn() && (resource.data.freelancerUid == request.auth.uid || resource.data.clientUid == request.auth.uid);
      allow create: if hasRole('freelancer')
        && request.resource.data.freelancerUid == request.auth.uid
        && id == request.resource.data.projectId + '_' + request.auth.uid
        && request.resource.data.status == 'sent'
        && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.status == 'open'
        && request.resource.data.clientUid == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.clientUid
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.rate is number && request.resource.data.rate >= 0;
      allow update: if isOwner(resource.data.clientUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['sent', 'shortlisted', 'declined'];
      allow delete: if isOwner(resource.data.freelancerUid);
    }

    match /savedSearches/{id} {
      allow read: if signedIn() && resource.data.clientUid == request.auth.uid;
      allow create: if hasRole('client') && request.resource.data.clientUid == request.auth.uid;
      allow update: if isOwner(resource.data.clientUid) && request.resource.data.clientUid == resource.data.clientUid;
      allow delete: if isOwner(resource.data.clientUid);
    }

    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.targetType in ['profile', 'message']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3 && request.resource.data.reason.size() <= 500;
      allow update, delete: if false;
    }

    match /profileStats/{uid}/days/{day} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Everything else (rate_limits, mail, reviewSummaries, viewers) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
