# Copy to server/.env (gitignored). All values below are placeholders.

# Required
DATABASE_URL="postgres://bench:CHANGE_ME@127.0.0.1:5432/bench"
# Only used by `npm run test:api`; point it at an empty throwaway database.
TEST_DATABASE_URL="postgres://bench:CHANGE_ME@127.0.0.1:5432/bench_test"

# Server
PORT=8787
HOST=127.0.0.1
APP_URL="http://localhost:5173"
APP_ORIGINS="http://localhost:5173"
# Set true behind a reverse proxy so client IPs come from X-Forwarded-For.
TRUST_PROXY=false

# Optional: AI features fall back to local logic without a key.
# GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional: without SMTP_URL, outgoing email is printed to the console instead.
# SMTP_URL="smtps://user:password@smtp.example.com"
MAIL_FROM="Bench <no-reply@example.com>"

# Optional: where uploaded files live (defaults to server/.data/files).
# STORAGE_DIR="/var/lib/bench/files"
# SENTRY_DSN=""

# Serve the built frontend (npm run build) from this process. Defaults to ../dist when present; set to "" to disable.
# STATIC_DIR=""
