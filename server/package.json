{
  "name": "bench-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "admin:grant": "tsx --env-file-if-exists=.env src/db/grant-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.7",
    "@fastify/websocket": "^11.3.6",
    "@google/generative-ai": "^0.24.1",
    "fastify": "^5.12.8",
    "nodemailer": "^10.3.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
