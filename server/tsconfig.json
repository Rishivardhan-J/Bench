{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "ES2023"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "../src/types/index.ts",
    "../src/lib/search/index.ts",
    "../src/lib/completeness.ts",
    "../src/lib/format.ts"
  ]
}