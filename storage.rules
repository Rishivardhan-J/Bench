rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function participantsOf(threadId) {
      return firestore.get(/databases/(default)/documents/threads/$(threadId)).data.participants;
    }

    // Avatars and portfolio images are public; only the owner may upload.
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if isOwner(uid);
    }
    match /portfolio/{uid}/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if isOwner(uid);
    }

    // Resumes are private: owner and admin only.
    match /resumes/{uid}/{file} {
      allow read: if isOwner(uid) || (signedIn() && request.auth.token.admin == true);
      allow write: if isOwner(uid) && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isOwner(uid);
    }

    // Message attachments: only the two participants.
    match /attachments/{threadId}/{file} {
      allow read: if signedIn() && request.auth.uid in participantsOf(threadId);
      allow create: if signedIn() && request.auth.uid in participantsOf(threadId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)|application/pdf|text/plain');
    }
  }
}
